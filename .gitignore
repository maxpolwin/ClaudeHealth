.DS_Store
**/.DS_Store
xcuserdata/
.swiftpm/
*.swp
*.swo
*.xcscmblueprint
*.xccheckout

# Editors
.vscode/
.idea/
*.iml

# Local environment overrides (forks may add)
.env
.env.local
*.local
