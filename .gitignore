# Build artifacts
build/
.build/
DerivedData/
*.xcodeproj/
Resources/GeneratedInfo.plist

# Distribution outputs
*.dmg
*.zip
*.app

# Generated icon intermediates (the .icns themselves ARE committed)
Resources/AppIcon-*.iconset/
Resources/*.iconset/
